APP_NAME=Totché
APP_ENV=production
# Laissé vide volontairement : généré automatiquement au premier démarrage
# du conteneur (cf. docker/entrypoint.sh) - jamais besoin d'y toucher.
APP_KEY=
APP_DEBUG=false
# URL publique de l'API (celle que les clients/le frontend appellent).
APP_URL=http://localhost:8000
# URL publique du frontend - utilisée pour construire les liens dans les
# emails (réinitialisation de mot de passe, notifications).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Valeurs alignées sur docker-compose.yml - ne pas changer sans changer les
# deux en même temps.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=benin_tourisme
DB_USERNAME=benin_user
DB_PASSWORD=benin_pass

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ── Email ──────────────────────────────────────────────────────────────
# Par défaut "log" : les emails (mot de passe oublié, notifications) sont
# écrits dans storage/logs/laravel.log au lieu d'être réellement envoyés -
# rien ne casse, mais personne ne les reçoit. Pour un envoi réel, renseigner
# un fournisseur SMTP (ex. Brevo, gratuit jusqu'à 300 emails/jour) :
# Brevo (ex-Sendinblue) SMTP gratuit : https://app.brevo.com/settings/keys/smtp
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=<login SMTP Brevo, ex xxxxx@smtp-brevo.com>
# MAIL_PASSWORD=<cle SMTP Brevo, format xsmtpsib-...>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS doit être un expéditeur vérifié dans le compte Brevo
# (Senders, Domains) sinon Brevo rejette l'envoi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@totche.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Paiement Kkiapay (sandbox par défaut - créer un compte sur
# https://kkiapay.me pour obtenir ses propres clés, sandbox ou live) ──────
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# ── Circuit IA (endpoint compatible OpenAI chat/completions - Groq/
# OpenRouter/Mistral/Gemini fonctionnent tous avec cette même forme) ──────
# Sans ces 3 valeurs, la génération de circuit par IA répond simplement
# "non configuré" (503) - le reste du site fonctionne normalement.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
